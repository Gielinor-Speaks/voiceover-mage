# Voiceover Mage Configuration
# Copy this to .env and fill in your values

# Database Configuration
VOICEOVER_MAGE_DATABASE_URL=sqlite+aiosqlite:///./data/voiceover_mage.db

# API Keys
VOICEOVER_MAGE_GEMINI_API_KEY=your_gemini_key_here
VOICEOVER_MAGE_ELEVENLABS_API_KEY=your_elevenlabs_key_here

# Local TTS Service
VOICEOVER_MAGE_LOCAL_TTS_API_URL=http://localhost:8001

# Logging
VOICEOVER_MAGE_LOG_LEVEL=INFO
VOICEOVER_MAGE_LOG_MODE=interactive
