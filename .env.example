# Voiceover Mage Configuration
# Copy this file to .env and fill in your values

# AI/API Configuration
VOICEOVER_MAGE_GEMINI_API_KEY=your_google_gemini_api_key_here

# Logging Configuration
VOICEOVER_MAGE_LOG_LEVEL=INFO
VOICEOVER_MAGE_LOG_FILE=

# Voice generation
VOICEOVER_MAGE_ELEVENLABS_API_KEY="your_elevenlabs_api_key_here"
VOICEOVER_MAGE_LOCAL_TTS_API_URL="http://localhost:8000"
